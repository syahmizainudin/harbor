# harbor settings. Copy to .env (next to where you run harbor) or ~/.config/harbor/.env,
# or point to any file with --env-file / HARBOR_ENV_FILE. Every line is optional.
# Precedence: command-line flags > environment variables > this file > defaults.
# .env is git-ignored. Never commit a real API key.

# Console
HARBOR_PORT=8765
# HARBOR_JOBS=1            # archives converted at the same time
# HARBOR_THREADS=4         # image-encoding threads (default: CPU count)
# HARBOR_DOWNLOADS=2       # downloads at the same time

# Convert tab defaults
HARBOR_QUALITY=80
HARBOR_DELETE_ORIGINAL=true
# HARBOR_METHOD=4          # encoder effort 0 (fastest) - 6 (smallest files)

# Download tab defaults
# HARBOR_DOWNLOAD_DIR=/mnt/d/Downloads/Comics
# HARBOR_AUTH_MODE=bearer  # none | bearer | header | query
# HARBOR_AUTH_NAME=X-API-Key   # header name (header mode) or parameter name (query mode)
# HARBOR_RETRIES=3         # extra attempts after a temporary download failure

# API key. Stays on the server: the page is only told that one exists, and uses it when
# its key field is left empty.
# HARBOR_API_KEY=

# Unfinished jobs are saved here and added back when harbor starts (the key is never saved)
# HARBOR_STATE_FILE=~/.local/state/harbor/queue.json
# HARBOR_RESTORE=true

# Library tab (cbz-shelf). Its own database, separate from a standalone cbz-shelf's.
# HARBOR_LIBRARY_DB=~/.local/share/harbor/library.db
# HARBOR_LIBRARY_SCAN=true   # rescan library folders when harbor starts

# Origins allowed to send requests besides the page. Default: harbor's own Chrome extension.
# A comma-separated list of exact origins, or "off".
# HARBOR_EXTENSION_ORIGINS=chrome-extension://pioghlmpnbcbgiemaphgpnendofahggb
