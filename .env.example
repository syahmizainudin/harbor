# harbor settings. Copy to .env (next to where you run harbor) or ~/.config/harbor/.env,
# or point to any file with --env-file / HARBOR_ENV_FILE. Every line is optional.
# Precedence: command-line flags > environment variables > this file > defaults.
# .env is git-ignored. Never commit a real API key.

# Console
HARBOR_PORT=8765
# HARBOR_JOBS=1            # archives converted at the same time
# HARBOR_THREADS=4         # image-encoding threads (default: CPU count)
# HARBOR_DOWNLOADS=2       # downloads at the same time

# Convert tab defaults
HARBOR_QUALITY=80
HARBOR_DELETE_ORIGINAL=true
# HARBOR_METHOD=4          # encoder effort 0 (fastest) - 6 (smallest files)

# Download tab defaults
# HARBOR_DOWNLOAD_DIR=/mnt/d/Downloads/Comics
# HARBOR_AUTH_MODE=bearer  # none | bearer | header | query
# HARBOR_AUTH_NAME=X-API-Key   # header name (header mode) or parameter name (query mode)
# HARBOR_RETRIES=3         # extra attempts after a temporary download failure

# API key. Stays on the server: the page is only told that one exists, and uses it when
# its key field is left empty.
# HARBOR_API_KEY=

# Unfinished jobs are saved here and added back when harbor starts (the key is never saved)
# HARBOR_STATE_FILE=~/.local/state/harbor/queue.json
# HARBOR_RESTORE=true

# Library tab (cbz-shelf). Its own database, separate from a standalone cbz-shelf's.
# HARBOR_LIBRARY_DB=~/.local/share/harbor/library.db
# HARBOR_LIBRARY_SCAN=true   # rescan library folders when harbor starts

# Origins allowed to send requests besides the page. Default: harbor's own Chrome extension.
# A comma-separated list of exact origins, or "off".
# HARBOR_EXTENSION_ORIGINS=chrome-extension://pioghlmpnbcbgiemaphgpnendofahggb

# Accounts. Make the first one with: harbor user add NAME --admin
# HARBOR_ACCOUNTS=true          # false: no sign-in, anyone who can reach the page can use it
# HARBOR_ACCOUNTS_DB=~/.local/share/harbor/harbor.db
# HARBOR_SESSION_DAYS=30        # how long a sign-in lasts after it was last used
# HARBOR_SECURE_COOKIE=false    # true only when harbor is served over HTTPS

# History of finished conversions and downloads, and the audit log of account and admin events.
# HARBOR_HISTORY_DB=~/.local/share/harbor/history.db
# HARBOR_HISTORY_DAYS=90        # days finished jobs are kept; 0 keeps them forever
# HARBOR_AUDIT_DAYS=365         # days audit events are kept; 0 keeps them forever

# Reading from other devices (phone, tablet). Off by default: harbor listens on 127.0.0.1 only.
# Anything else needs HTTPS, HARBOR_SECURE_COOKIE=true, accounts, and the names devices use.
# See README, "Reading from other devices".
# HARBOR_HOST=0.0.0.0                   # listen on every network address (needs TLS below)
# HARBOR_ALLOWED_HOSTS=harbor.lan,192.168.1.20
# HARBOR_TLS_CERT=~/.config/harbor/cert.pem
# HARBOR_TLS_KEY=~/.config/harbor/key.pem   # chmod 600
# HARBOR_TRUST_PROXY=false              # true: a reverse proxy on this machine serves HTTPS; keep HARBOR_HOST=127.0.0.1

# Downloads: a speed limit for all of them together, and hours when new ones may start.
# HARBOR_DOWNLOAD_RATE=5M               # 500K, 5M, 1.5M… (bytes a second); 0 = no limit
# HARBOR_DOWNLOAD_HOURS=01:00-07:00     # may cross midnight; running downloads finish

# Watch folders: archives that appear in them are converted on their own, with the Convert
# defaults above. Several folders: separate them with ";".
# HARBOR_WATCH_DIRS=/mnt/d/Inbox;/mnt/d/Other inbox
# HARBOR_WATCH_DELETE_ORIGINAL=false    # stays false unless set here, whatever HARBOR_DELETE_ORIGINAL says
# HARBOR_WATCH_POLL=30                  # seconds between checks
